# 模型与 HTML 生成
RESEARCH_INTEL_API_BASE_URL=https://example.com/v1/chat/completions
RESEARCH_INTEL_API_KEY=replace-me
RESEARCH_INTEL_HTML_MODELS=gemini-flash-latest,gemini-2.5-pro-1m
RESEARCH_INTEL_CURATION_MODELS=gemini-flash-latest
RESEARCH_INTEL_CHAT_TIMEOUT_MS=60000
# 默认启用 Codex 对 HTML 结果做二次强化；若你明确不使用 Codex，可手动留空跳过
RESEARCH_INTEL_CODEX_HTML_MODEL=gpt-5.4-mini
RESEARCH_INTEL_CODEX_HTML_TIMEOUT_MS=120000
RESEARCH_INTEL_RATE_LIMIT_PER_MINUTE=5

# Web 控制台
RESEARCH_INTEL_WEB_PORT=3086
RESEARCH_INTEL_WEB_HOST=0.0.0.0
RESEARCH_INTEL_WEB_PASSWORD=change-me
RESEARCH_INTEL_WEB_SESSION_SECRET=change-me-too
RESEARCH_INTEL_PUBLIC_MODE=

# 调度
RESEARCH_INTEL_RUN_MODE=codex
RESEARCH_INTEL_SCHEDULE_POLL_SECONDS=60
RESEARCH_INTEL_VERIFY_DELAY_MINUTES=40

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_USE_PROXY=false
TELEGRAM_PROXY_URL=

# 浏览器 / 模板
RESEARCH_INTEL_CHROME_PATH=
RESEARCH_INTEL_HTML_TEMPLATE_PATH=
