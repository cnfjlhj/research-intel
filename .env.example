# HTML 生成提供者选择
# 可选值：codex（默认）或 claude-code
# codex 使用 OpenAI Codex CLI 进行 HTML 生成
# claude-code 使用 Anthropic Claude Code CLI 进行 HTML 生成
RESEARCH_INTEL_HTML_PROVIDER=codex

# Codex-first HTML 生成（公开默认路径）
# 第一次本地 smoke run 通常不用改这几项；先确认 codex CLI 自己已经能跑通即可。
RESEARCH_INTEL_CODEX_HTML_MODEL=gpt-5.4
RESEARCH_INTEL_CODEX_HTML_REASONING_EFFORT=medium
RESEARCH_INTEL_CODEX_HTML_TIMEOUT_MS=1800000

# Claude Code HTML 生成
# 当 RESEARCH_INTEL_HTML_PROVIDER=claude-code 时使用以下配置
# RESEARCH_INTEL_CLAUDE_CODE_BIN=              # 显式指定 claude 二进制路径（可选，默认从 PATH 查找）
RESEARCH_INTEL_CLAUDE_CODE_HTML_MODEL=claude-sonnet-4-6
RESEARCH_INTEL_CLAUDE_CODE_HTML_TIMEOUT_MS=1800000

# 每分钟限流，避免 discovery/curation 过于频繁
RESEARCH_INTEL_RATE_LIMIT_PER_MINUTE=5

# Web 控制台
# 如果你要启动 Web，这两项至少要改成自己的值。
RESEARCH_INTEL_WEB_PORT=3086
RESEARCH_INTEL_WEB_HOST=0.0.0.0
RESEARCH_INTEL_WEB_PASSWORD=change-me
RESEARCH_INTEL_WEB_SESSION_SECRET=change-me-too
RESEARCH_INTEL_PUBLIC_MODE=

# 调度
RESEARCH_INTEL_SCHEDULE_POLL_SECONDS=60
RESEARCH_INTEL_VERIFY_DELAY_MINUTES=40

# Telegram
# 第一次试跑 `npm run daily:no-telegram` 时可以留空；只在你准备真实推送时再填写。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_USE_PROXY=false
TELEGRAM_PROXY_URL=

# 浏览器 / 模板
# 只有浏览器校验阶段找不到可用浏览器时，才需要手动设置 RESEARCH_INTEL_CHROME_PATH。
RESEARCH_INTEL_CHROME_PATH=
RESEARCH_INTEL_HTML_TEMPLATE_PATH=
